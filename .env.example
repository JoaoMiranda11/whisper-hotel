# Copy to .env and fill. Never commit .env.

# --- LiveKit ---
# Generate with: docker run --rm livekit/livekit-server:v1.13.10 generate-keys
LK_KEY=devkey
# Must be >= 32 chars.
LK_SECRET=change-me-to-a-long-random-secret-0123456789
# URL the BROWSER uses to reach LiveKit signaling (ws:// on localhost, wss:// in production).
LK_PUBLIC_URL=ws://127.0.0.1:7880
# IP advertised to browsers in ICE candidates. 127.0.0.1 for same-machine dev; public IP in production.
LK_NODE_IP=127.0.0.1
# Embedded TURN (see docs/voice.md). Keep false in dev.
LK_TURN_ENABLED=false
LK_TURN_DOMAIN=

# --- voice-sidecar ---
# HMAC secret for voice passes. Generate with: openssl rand -base64 48
VOICE_AUTH_SECRET=change-me-generate-with-openssl-rand
# Exact origin(s) serving Nitro, comma-separated. Must match the browser's Origin header.
NITRO_ORIGIN=http://127.0.0.1:1080,http://localhost:1080
# Public URL used by mint-link to build entry links.
NITRO_PUBLIC_URL=http://127.0.0.1:1080
